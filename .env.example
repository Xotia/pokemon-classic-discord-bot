# Discord
DISCORD_TOKEN=
APPLICATION_ID=
PUBLIC_KEY=
ADMIN_ID=

# Serveurs Discord (guildId, nom, salon d'annonce de raid) : voir data/guilds.json,
# maintenu à la main, un serveur par entrée.

# Les scripts d'annonce ponctuelle (send-lore*.js, send-maintenance.ts,
# send-back-online.ts, send-quick-*.ts) ne lisent plus un salon fixe depuis
# le .env — on passe le salon ciblé en argument, ex :
# npx ts-node src/scripts/send-maintenance.ts --channelId <id-du-salon>

# Gameplay — valeurs par défaut pour tous les serveurs. Chaque serveur peut
# surcharger n'importe lequel de ces réglages individuellement dans son
# entrée de data/guilds.json (shinyRate, cooldownMinutes, pityThreshold,
# pokemonPerPage, buttonTimeoutMs, generationNumber, raidSchedulerMode,
# raidNextZoneChance, raidStartHour, raidEndHour). Un serveur sans overrides
# utilise telles quelles les valeurs ci-dessous. Voir src/config/guildSettings.ts.
SHINY_RATE=256
COOLDOWN=30
PITY_THRESHOLD=10
POKEMON_PER_PAGE=20
BUTTON_TIMEOUT=120000
GENERATION_NUMBER=3

# Raid (horaires/réglages par défaut ; la cible — quel raid.json, quel salon
# d'annonce — vient de data/guilds.json, tout comme les overrides éventuels)
RAID_SCHEDULER_MODE=debug
RAID_NEXT_ZONE_CHANCE=60
RAID_START_HOUR=00 12 * * *
RAID_END_HOUR=00 20 * * *

# Pokemon list generation
# EXTRA_POKEMON_FILES=othermons.json

# Déploiement (script get-last-update.ts)
# Nom de la session screen dans laquelle tourne le bot en prod.
BOT_SCREEN_SESSION=