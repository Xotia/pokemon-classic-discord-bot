{
  "name": "pokemon-classic-discord-bot",
  "version": "3.6.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "generate-pokemon-list": "node scripts/generate-pokemon-list.js",
    "build": "npm run generate-pokemon-list && tsc",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "npx ts-node src/index.ts",
    "deploy": "npx ts-node src/deploy-commands.ts",
    "deploy:dev": "npx ts-node src/deploy-commands-dev.ts",
    "deploy:dev:clear": "npx ts-node src/deploy-commands-dev.ts --clear",
    "simulate:capture": "npx ts-node src/scripts/zones/simulateCapture.ts",
    "test:rarity": "npx ts-node src/scripts/rarity/testRarity.ts",
    "compare:rarity": "npx ts-node src/scripts/rarity/compareRarityWithManual.ts",
    "force-start-raid": "npx ts-node src/scripts/raid-tools/forceStartRaid.ts",
    "force-end-raid": "npx ts-node src/scripts/raid-tools/forceEndRaid.ts",
    "simulate:raid-zones": "npx ts-node src/scripts/raid-tools/simulateRaidZones.ts",
    "generate-gen3": "npx ts-node src/scripts/gen-json/createGen3Json.ts",
    "inject-zones-gen3": "npx ts-node src/scripts/zones/injectZonesGen3.ts",
    "simulate-gen3-zones": "npx ts-node src/scripts/zones/simulateGen3Zones.ts",
    "apply-wandering-legendaries": "npx ts-node src/scripts/rarity/applyWanderingLegendaries.ts",
    "audit-gen1-gen2": "npx ts-node src/scripts/rarity/runRarityAuditGen1Gen2.ts",
    "compare-gen1-gen2": "npx ts-node src/scripts/rarity/compareRarityGen1Gen2WithProd.ts",
    "apply-gen1-gen2-rarity-changes": "npx ts-node src/scripts/rarity/applyGen1Gen2RarityChanges.ts",
    "regenerate-effectiveness": "npx ts-node src/scripts/gen-json/regenerateEffectiveness.ts",
    "init-research-data": "npx ts-node src/scripts/player-maintenance/init-research-data.ts",
    "send-message": "ts-node src/scripts/announcements/send-message.ts",
    "send-patchnote": "ts-node src/scripts/announcements/send-patchnote.ts",
    "send-meteorite-warning": "ts-node src/scripts/announcements/send-meteorite-warning.ts",
    "get-last-update": "ts-node src/scripts/get-last-update.ts",
    "raid-sim:build": "npx ts-node src/scripts/raid-tools/buildRaidSimulator.ts",
    "raid-sim": "npm run raid-sim:build && node tools/raid-simulator/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "csv-parse": "^6.2.1",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "pino": "^10.2.0",
    "pino-pretty": "^13.1.3"
  }
}
