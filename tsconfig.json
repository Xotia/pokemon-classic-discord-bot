{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "rootDir": "./src",
    "baseUrl": ".",
    "outDir": "./dist",
    "noEmit": false,
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "paths": {
      "~/*": ["src/*"],
      "@config/*": ["../../config/*"],
      "@methods/*": ["../../methods/*"],
      "@utils/*": ["../../utils/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests", "node_modules", "src/scripts/old", "src/scripts/buildPokemonJson.ts", "src/scripts/testGetMultiplier.ts", "src/scripts/test-raid-pokemon.ts", "src/scripts/createGenJson.ts", "src/scripts/injectZones.ts"]
}