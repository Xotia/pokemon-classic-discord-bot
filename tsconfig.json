{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "resolveJsonModule": true
  },
    "include": [
    "src/**/*",
    "tests/**/*"
  ]
}
